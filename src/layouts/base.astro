---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  lang: string;
};

const { title, description, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#121212" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link id="favicon" rel="icon" href="/favicon-frames/frame-000.png" type="image/png" />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const favicon = document.querySelector("#favicon");

        if (reduceMotion.matches || !favicon) {
          return;
        }

        const firstFrame = 0;
        const frameCount = 60;
        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d");
        let frameIndex = firstFrame;

        canvas.width = 16;
        canvas.height = 16;

        const frames = Array.from({ length: frameCount }, (_, index) => {
          const frame = new Image();
          frame.decoding = "async";
          frame.src = `/favicon-frames/frame-${String(index + firstFrame).padStart(3, "0")}.png`;
          return frame;
        });

        if (!context) {
          return;
        }

        const drawNextFrame = () => {
          const frame = frames[frameIndex - firstFrame];

          if (!frame.complete) {
            return;
          }

          context.clearRect(0, 0, canvas.width, canvas.height);
          context.drawImage(frame, 0, 0, canvas.width, canvas.height);
          favicon.href = canvas.toDataURL("image/png");
          frameIndex = ((frameIndex - firstFrame + 1) % frameCount) + firstFrame;
        };

        window.setInterval(drawNextFrame, 50);
      })();
    </script>
    <script is:inline>
      (() => {
        const sounds = {
          language: "/pill-select.webm",
          success: "/pill-select.webm",
          toggle: "/pill-select.webm",
        };

        const volumes = {
          language: 0.45,
          success: 0.35,
          toggle: 0.3,
        };

        Object.values(sounds).forEach((source) => {
          const audio = new Audio(source);
          audio.preload = "auto";
        });

        const playFile = (name) => {
          const source = sounds[name];
          if (!source) return;
          const audio = new Audio(source);
          audio.volume = volumes[name] ?? 0.25;
          return audio.play().catch(() => {});
        };

        const canDelayNavigation = (event, link) =>
          event.button === 0 &&
          !event.defaultPrevented &&
          !event.metaKey &&
          !event.ctrlKey &&
          !event.shiftKey &&
          !event.altKey &&
          !link.target &&
          !link.hasAttribute("download");

        const navigateAfterSound = (link) => {
          window.setTimeout(() => {
            window.location.href = link.href;
          }, 90);
        };

        window.playMicrockSound = playFile;

        document.addEventListener("click", (event) => {
          const trigger = event.target?.closest?.("[data-sound]");

          if (!trigger) {
            return;
          }

          playFile(trigger.getAttribute("data-sound"));
        }, { capture: true });

        document.addEventListener("click", (event) => {
          const link = event.target?.closest?.("a[data-sound]");

          if (!link || !canDelayNavigation(event, link)) {
            return;
          }

          event.preventDefault();
          navigateAfterSound(link);
        });
      })();
    </script>
    <script>
      // Cuelume toggle recipe: two bandpass-filtered noise bursts.
      // Synthesized inline so we can control the output gain to match
      // the 0.45 volume the old /pill-select.webm file used.
      const playLanguageToggle = (() => {
        let ctx = null;

        const noiseBurst = (context, dest, freq, q, peak, offset, attack, decay) => {
          const dur = attack + decay + 0.05;
          const len = Math.max(1, Math.floor(dur * context.sampleRate));
          const buf = context.createBuffer(1, len, context.sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < len; i++) data[i] = 2 * Math.random() - 1;

          const src = context.createBufferSource();
          src.buffer = buf;

          const filter = context.createBiquadFilter();
          filter.type = "bandpass";
          filter.frequency.value = freq;
          filter.Q.value = q;

          const gain = context.createGain();
          const t = context.currentTime + offset;
          gain.gain.setValueAtTime(0.0001, t);
          gain.gain.exponentialRampToValueAtTime(peak, t + attack);
          gain.gain.exponentialRampToValueAtTime(0.0001, t + attack + decay);

          src.connect(filter).connect(gain).connect(dest);
          src.start(t);
          src.stop(t + dur);
        };

        return () => {
          if (!ctx) {
            const Ctor = window.AudioContext || window.webkitAudioContext;
            if (!Ctor) return;
            ctx = new Ctor();
          }
          if (ctx.state !== "running") ctx.resume().catch(() => {});

          const master = ctx.createGain();
          // Scale so effective peak ≈ 0.45 (matching old HTML5 Audio volume)
          // Layer peaks are 0.12/0.1; 0.45 / 0.12 ≈ 3.75
          master.gain.value = 3.75;
          master.connect(ctx.destination);

          noiseBurst(ctx, master, 2200, 1.6, 0.12, 0,     0.001, 0.016);
          noiseBurst(ctx, master, 3800, 1.6, 0.10, 0.024, 0.001, 0.020);
        };
      })();

      document.addEventListener("click", (event) => {
        const trigger = event.target?.closest?.('[data-sound="language"]');
        if (!trigger) return;
        playLanguageToggle();
      }, { capture: true });
    </script>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Karla:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <figure class="noise-overlay" aria-hidden="true">
      <svg>
        <filter id="noise-bg-fx">
          <feTurbulence baseFrequency="0.8" />
        </filter>
      </svg>
    </figure>
    <slot />
  </body>
</html>
